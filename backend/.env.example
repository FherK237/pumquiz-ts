# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/pumquiz

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-16-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-16-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email (Brevo API - funciona en Render, envío a cualquier destinatario)
BREVO_API_KEY=xkeysib-your-api-key-here
EMAIL_FROM_NAME=PumQuiz!
EMAIL_FROM_ADDRESS=pumquiz.official@gmail.com

# CORS
FRONTEND_URL=http://localhost:5173
